{
  "name": "css-modules-content-mapper",
  "version": "0.2.0",
  "description": "TypeScript content mapper for CSS modules",
  "keywords": [
    "content-mapper",
    "css",
    "css-modules",
    "typescript"
  ],
  "homepage": "https://github.com/remcohaszing/css-modules-content-mapper#readme",
  "bugs": "https://github.com/remcohaszing/css-modules-content-mapper/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remcohaszing/css-modules-content-mapper.git",
    "directory": "packages/css-modules-content-mapper"
  },
  "funding": "https://github.com/sponsors/remcohaszing",
  "license": "MIT",
  "author": "Remco Haszing <remcohaszing@gmail.com>",
  "contributors": [
    "Brody McKee (https://github.com/mrmckeb)"
  ],
  "type": "module",
  "files": [
    "lib",
    "types"
  ],
  "exports": {
    "types": "./types/core.d.ts",
    "default": "./lib/core.js"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "lib/content-mapper.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "scripts": {
    "test": "node --test",
    "prepack": "tsc --build"
  },
  "dependencies": {
    "estree-util-is-identifier-name": "^3.0.0",
    "lodash.camelcase": "^4.0.0",
    "postcss-safe-parser": "^7.0.0",
    "postcss-selector-parser": "^7.0.0",
    "vscode-jsonrpc": "^10.0.0"
  },
  "devDependencies": {
    "@types/lodash.camelcase": "^4.0.0",
    "@types/node": "^26.0.0",
    "content-mapper-test-utils": "^0.0.1",
    "snapshot-fixtures": "^1.0.0",
    "typescript": "^6.0.0"
  }
}
